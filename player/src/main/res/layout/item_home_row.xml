<?xml version="1.0" encoding="utf-8"?>
<!-- Baris dua teks dipakai bersama oleh daftar Saluran dan Terakhir diputar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/molina_mint_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rowSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/molina_mint_text2"
        android:textSize="12sp" />
</LinearLayout>
