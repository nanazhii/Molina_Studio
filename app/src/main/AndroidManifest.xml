<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MolinaApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Molina"
        android:theme="@style/Theme.Molina.App"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/Theme.Molina.Splash"
            android:windowSoftInputMode="adjustResize" />

        <!-- Satu alias aktif pada satu waktu; dipilih di Setelan (IconPicker). -->
        <activity-alias
            android:name=".IconGreen"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="Molina"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAmber"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Molina Cinema"
            android:icon="@mipmap/ic_launcher_cinema"
            android:roundIcon="@mipmap/ic_launcher_cinema">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
