# Pin build native proot Molina Terminal (arm64). Ubah SADAR dan catat di progres.md.
# Sumber proot: fork Termux (disesuaikan untuk bionic/Android); SHA = HEAD saat pin ditulis (2026-11-13).
PROOT_REPO=https://github.com/termux/proot # gate:allow sumber pin build, bukan telemetri
PROOT_SHA=52d65a4dc140ca554d241a1438ddd4f6b00c9813
# talloc 2.4.4 lewat mirror git Samba di GitHub (commit hasil peel dari tag talloc-2.4.4).
TALLOC_REPO=https://github.com/samba-team/samba # gate:allow sumber pin build, bukan telemetri
TALLOC_TAG=talloc-2.4.4
TALLOC_SHA=51d05da70e8461834396d361eead807127751b76
# NDK memakai pin yang sama dengan pipeline mpv (native/pins.env: NDK_VERSION, NDK_REVISION).
ANDROID_API=26
