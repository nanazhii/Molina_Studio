# Pin runtime yt-dlp Molina Player (arm64): CPython bionic + zipapp yt-dlp + quickjs-ng. Ubah SADAR dan catat di progres.md.
# Unduhan berkas (zipapp, dependensi CPython) diverifikasi lewat native/pins.sha256; sumber git dipin ke SHA commit.
# CPython: build resmi upstream Android/android.py (PEP 738), SHA = hasil peel tag v3.14.10.
CPYTHON_REPO=https://github.com/python/cpython # gate:allow sumber pin build, bukan telemetri
CPYTHON_TAG=v3.14.10
CPYTHON_SHA=b703b2c5e704341d61e367b9b940b77ed11dded0
CPYTHON_HOST=aarch64-linux-android
# Dependensi biner yang diunduh android.py (daftar HARUS sama dengan unpack_deps() pada commit di atas; skrip memeriksanya).
CPYTHON_DEPS_BASE=https://github.com/beeware/cpython-android-source-deps/releases/download # gate:allow sumber pin build, bukan telemetri
CPYTHON_DEPS="bzip2-1.0.8-3 libffi-3.4.4-3 openssl-3.5.9-0 sqlite-3.53.4-0 xz-5.4.6-1 zstd-1.5.7-2"
# quickjs-ng: runtime JS untuk yt-dlp (--js-runtimes quickjs). Tag ringan v0.18.0.
QJS_REPO=https://github.com/quickjs-ng/quickjs # gate:allow sumber pin build, bukan telemetri
QJS_TAG=v0.18.0
QJS_SHA=d7215b0ad3fc2c562e8317fd9bca058fd4863804
# yt-dlp zipapp (sudah memuat yt_dlp_ejs). SHA-256 sama dengan SHA2-256SUMS rilis dan baris di native/pins.sha256.
YTDLP_VERSION=2026.10.26
YTDLP_URL=https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp # gate:allow sumber pin build, bukan telemetri
YTDLP_SHA256=e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3
