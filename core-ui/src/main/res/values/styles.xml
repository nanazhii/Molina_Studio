<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.Molina.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/molina_radius</item>
    </style>

    <style name="TextAppearance.Molina.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- molina-patch20: nav ringkas (56dp), ikon gradien RGB membawa warna sendiri -->
    <style name="Widget.Molina.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/molina_surface</item>
        <item name="android:minHeight">64dp</item>
        <item name="itemIconTint">@null</item>
        <item name="itemTextColor">@color/molina_nav_label</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Molina.BottomNav.Indicator</item>
    </style>

    <style name="Widget.Molina.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">28dp</item>
    </style>
</resources>
