# Molina Terminal - nanorc bawaan (dibuat otomatis, ditimpa tiap sesi).
# Ingin kustom sendiri? Buat ~/.nanorc, maka berkas ini tidak dipakai lagi.

# Tampilan: hemat layar ponsel
set minibar
set nohelp
set linenumbers
set indicator
set mouse
set softwrap

# Pengeditan ala code editor
set autoindent
set tabsize 4
set tabstospaces
set smarthome
set zap

# Sorotan sintaks Debian
include "/usr/share/nano/*.nanorc"

# Warna tema Molina. Hex 3 digit, perlu terminal 256 warna.
set titlecolor bold,#000,#2c7
set minicolor bold,#000,#2c7
set statuscolor bold,#000,#9e6
set promptcolor bold,#000,#9e6
set errorcolor bold,#fff,#f55
set selectedcolor #000,#fd5
set spotlightcolor #000,#fd5
set numbercolor #999
set scrollercolor #2c7
set keycolor #2c7
set functioncolor #eee

# Shortcut ala code editor (dikirim oleh baris tombol nano di aplikasi)
bind ^S savefile main
bind ^Q exit main
bind ^Z undo main
bind ^Y redo main
bind ^C copy main
bind ^X cut main
bind ^V paste main
bind ^F whereis main
bind ^R replace main
bind ^G gotoline main
bind ^_ comment main
# Ctrl+A: pilih semua
bind ^A "{firstline}{home}{mark}{lastline}{end}" main

# Alt+R: simpan, keluar, lalu jalankan skrip dari berkasnya (pembungkus nano yang menjalankan)
bind M-r "{savefile}{execute}touch $MOLINA_RUN_FLAG{enter}{exit}" main
# Alt+F: simpan, keluar; pembungkus menjalankan 'molina-run --fix' lalu membuka nano lagi
bind M-f "{savefile}{execute}touch $MOLINA_FIX_FLAG >/dev/null 2>&1{enter}{exit}" main
